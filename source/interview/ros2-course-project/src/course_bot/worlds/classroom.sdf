<?xml version="1.0"?>
<sdf version="1.9">
  <world name="classroom">
    <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <gravity>0 0 -9.8</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction><cast_shadows>true</cast_shadows>
    </light>
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.8 0.86 0.92 1</background></scene>
    <model name="ground">
      <static>true</static><link name="ground_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="north_wall"><static>true</static><pose>0 4 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>10 0.15 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>10 0.15 1</size></box></geometry></visual>
    </link></model>
    <model name="south_wall"><static>true</static><pose>0 -4 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>10 0.15 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>10 0.15 1</size></box></geometry></visual>
    </link></model>
    <model name="west_wall"><static>true</static><pose>-5 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.15 8 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.15 8 1</size></box></geometry></visual>
    </link></model>
    <model name="east_wall"><static>true</static><pose>5 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.15 8 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.15 8 1</size></box></geometry></visual>
    </link></model>
    <model name="island_a"><static>true</static><pose>1.5 0.8 0.4 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>1 1.4 0.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1 1.4 0.8</size></box></geometry><material><diffuse>0.3 0.5 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="island_b"><static>true</static><pose>-1.6 -1.3 0.4 0 0 0.3</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.8 1.2 0.8</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 1.2 0.8</size></box></geometry><material><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
